{% macro render_val(val) -%}
  {%- if val is sameas true -%}
    true
  {%- elif val is sameas false -%}
    false
  {%- elif val is none -%}
    null
  {%- elif val is number -%}
    {{ val }}
  {%- elif val is mapping -%}
    [
    {% for k, v in val.items() %}
      '{{ k }}' => {{ render_val(v) }},
    {% endfor %}
    ]
  {%- elif val is iterable and val is not string -%}
    [
    {% for item in val %}
      '{{ item | string | replace("'", "\\'") }}',
    {% endfor %}
    ]
  {%- else -%}
    '{{ val | string | replace("'", "\\'") }}'
  {%- endif -%}
{%- endmacro %}

$CONFIG = [
{% for key, value in nextcloud_config_vars.items() %}
  '{{ key }}' => {{ render_val(value) }},
{% endfor %}
];